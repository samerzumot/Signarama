<!-- RENDER LOGIC -->
{% if title %}
  <!-- JSON-LD Structured Data for SEO -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Service",
    "name": "{{ title }}",
    "image": [
      {% if main_image contains 'http' %}"{{ main_image }}"{% else %}"{{ main_image | asset_url }}"{% endif %}
    ],
    "description": "{{ description }}",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Signarama Vaughan",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "3300 Steeles Ave W",
        "addressLocality": "Vaughan",
        "addressRegion": "ON",
        "postalCode": "L4K 2Y4",
        "addressCountry": "CA"
      },
      "telephone": "+19056699313"
    },
    "areaServed": "Toronto, Vaughan, Richmond Hill, Markham"
  }
  </script>

  <!-- Page Content -->
  <!-- Padding increased to 160px to clear fixed header on desktop -->
  <div class="product-details-page">
    <div class="page-width container">
      
      <!-- Hero / Main Product Section -->
      <div class="product-hero">
      <div class="product-image-container" style="position: relative;">
           <button class="main-image-nav prev" aria-label="Previous Image">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
           </button>
           
           {% if main_image contains 'http' %}
             <img src="{{ main_image }}" alt="{{ title }} - Main Image" id="main-product-image" width="800" height="600" fetchpriority="high" decoding="sync" style="width: 100%; height: auto; object-fit: contain;">
           {% else %}
             <img src="{{ main_image | asset_url }}" alt="{{ title }} - Main Image" id="main-product-image" width="800" height="600" fetchpriority="high" decoding="sync" style="width: 100%; height: auto; object-fit: contain;">
           {% endif %}

           <button class="main-image-nav next" aria-label="Next Image">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
           </button>
        </div>
        
        <div class="product-info">
          <h1 class="product-title">{{ title }}</h1>
          <p class="product-description-short">{{ description }}</p>
          <p class="product-description-long">{{ long_description }}</p>
          
          <div class="cta-wrapper" style="margin-top: 3rem;">
             {% assign clean_title = title | remove: " in Vaughan" | remove: " - Toronto & Vaughan" | remove: " Vaughan" %}
             <button id="product-quote-trigger" class="btn-primary btn-quote" data-product="{{ title }}">Get {{ clean_title }} Quote</button>
          </div>
        </div>
      </div>

      <hr style="margin: 3rem 0; border: 0; border-top: 1px solid #eee;">

      <!-- Image Gallery (Horizontal Scroll) - Header Removed -->
      <!-- Image Gallery (Horizontal Scroll) -->
      <div class="product-gallery" style="position: relative;">
        <button class="gallery-nav prev" aria-label="Previous Image">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
        </button>
        
        <div class="gallery-scroll-container" id="gallery-scroller">
          {% for img in gallery_images %}
            <div class="gallery-item">
              {% if img contains 'http' %}
                 <img src="{{ img }}" alt="{{ title }} Gallery Image {{ forloop.index }}" loading="lazy" decoding="async" width="300" height="220">
              {% else %}
                 <img src="{{ img | asset_url }}" alt="{{ title }} Gallery Image {{ forloop.index }}" loading="lazy" decoding="async" width="300" height="220">
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <button class="gallery-nav next" aria-label="Next Image">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Global Modal in theme.liquid handles the quote logic now -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Gallery Logic Only (Modal Logic Moved to Theme)
      var mainImage = document.getElementById('main-product-image');
      if (mainImage) {
          var items = document.querySelectorAll('.gallery-item img');
          var currentIndex = 0;
          
          // Collect all image sources
          var images = [];
          // Add main image as first? No, usually gallery includes main? 
          // Use gallery-item imgs as the source list.
          // Wait, the main image might NOT be in the gallery loop if not duplicated.
          // The template has `gallery_images`. Does it include `main_image`?
          // Looking at data logic: `gallery_images = "..." | split: ','`.
          // Often main image is separate.
          // I will use `items` as the source of truth for navigation if user wants to scroll THROUGH gallery on main image.
          // Or should I include the initial main image?
          // Let's assume the gallery items represent the browsable set.
          
          for (var i = 0; i < items.length; i++) {
              images.push(items[i].src);
              items[i].addEventListener('click', function() {
                  mainImage.src = this.src;
                  // Update index based on click
                  // Find index of this.src in images array
                  // Need to be careful with URLs (absolute vs relative). match by checking logic or just tracking 'i'
              });
              items[i].setAttribute('data-index', i);
              items[i].addEventListener('click', function() {
                 currentIndex = parseInt(this.getAttribute('data-index'));
              });
              items[i].style.cursor = 'pointer';
          }

          // Main Image Arrows
          const mainPrev = document.querySelector('.main-image-nav.prev');
          const mainNext = document.querySelector('.main-image-nav.next');

          if (mainPrev && mainNext && images.length > 0) {
              mainPrev.addEventListener('click', function() {
                  currentIndex = (currentIndex > 0) ? currentIndex - 1 : images.length - 1;
                  mainImage.src = images[currentIndex];
              });

              mainNext.addEventListener('click', function() {
                  currentIndex = (currentIndex < images.length - 1) ? currentIndex + 1 : 0;
                  mainImage.src = images[currentIndex];
              });
          }
      }

      // Scroll Arrow Logic
      const scroller = document.getElementById('gallery-scroller');
      const prevBtn = document.querySelector('.gallery-nav.prev');
      const nextBtn = document.querySelector('.gallery-nav.next');

      if (scroller && prevBtn && nextBtn) {
        prevBtn.addEventListener('click', () => {
          scroller.scrollBy({ left: -320, behavior: 'smooth' });
        });
        nextBtn.addEventListener('click', () => {
          scroller.scrollBy({ left: 320, behavior: 'smooth' });
        });
      }
    });
  </script>

  <style>
    /* :root block removed to prevent overriding global theme variables (header color fix) */
    
    .product-details-page {
      padding: 160px 0 80px 0; /* More breathing room at bottom */
      background-color: #fcfcfc; /* Subtle off-white background for premium feel */
    }
    
    .page-width.container {
        max-width: 1280px; /* Slightly wider for modern screens */
        margin: 0 auto;
        padding: 0 2rem;
    }

    .product-hero {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr; /* Give image slightly more width */
      gap: 5rem;
      margin-bottom: 5rem;
      align-items: center; /* Center align vertically for balance */
    }
    
    .product-image-container {
      width: 100%;
      height: 550px !important; /* Taller hero image */
      background: #ffffff;
      border: 1px solid #eee;
      border-radius: 12px; /* Softer corners */
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      box-shadow: 0 10px 30px rgba(0,0,0,0.05); /* Soft shadow */
    }

    #main-product-image {
      width: 100% !important;
      height: 100% !important;
      object-fit: contain !important;
      max-height: 550px;
      padding: 20px;
    }
    
    .product-info {
      padding-right: 1rem;
    }

    .product-title {
      font-size: 3rem; /* Larger, more impactful title */
      line-height: 1.1;
      font-weight: 800;
      color: #222;
      margin-bottom: 1.5rem;
      letter-spacing: -0.02em;
    }

    .product-description-short {
      font-size: 1.35rem; /* Larger introduction text */
      line-height: 1.5;
      color: #444;
      font-weight: 500;
      margin-bottom: 1.5rem;
    }

    .product-description-long {
      font-size: 1.05rem;
      line-height: 1.7;
      color: #666;
      margin-bottom: 2.5rem;
    }
    
    /* Horizontal Scroll Gallery */
    .gallery-scroll-container {
      display: flex;
      overflow-x: auto;
      gap: 20px;
      padding: 10px 5px 20px 5px; /* Padding for shadow */
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      height: auto;
      align-items: flex-start;
    }
    
    .gallery-item {
      flex: 0 0 300px !important; 
      width: 300px !important;
      height: 220px !important;
      scroll-snap-align: start;
      border-radius: 8px;
      overflow: hidden;
      box-shadow: 0 4px 10px rgba(0,0,0,0.08);
      background: #fff;
      border: 1px solid #f0f0f0;
      transition: transform 0.2s;
    }

    .gallery-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: #fff;
      border: 1px solid #ddd;
      border-radius: 50%;
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 2;
      box-shadow: 0 4px 6px rgba(0,0,0,0.1);
      transition: all 0.2s;
    }
    
    .gallery-nav:hover {
      background: #f8f8f8;
      box-shadow: 0 6px 10px rgba(0,0,0,0.15);
    }
    
    .gallery-nav.prev {
      left: -20px;
    }
    
    .gallery-nav.next {
      right: -20px;
    }
    
    /* Main Image Navigation */
    .main-image-nav {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      background: rgba(255, 255, 255, 0.7);
      border: 1px solid #ddd;
      border-radius: 50%;
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 10;
      box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      transition: all 0.2s;
      opacity: 0; /* Hidden by default, shown on hover */
    }

    .product-image-container:hover .main-image-nav {
        opacity: 1;
    }

    .main-image-nav:hover {
      background: rgba(255, 255, 255, 0.95);
      transform: translateY(-50%) scale(1.1);
    }

    .main-image-nav.prev {
      left: 20px;
    }

    .main-image-nav.next {
      right: 20px;
    }

    /* Mobile: Always visible arrows */
    @media (max-width: 900px) {
        .main-image-nav {
            opacity: 1;
            width: 40px;
            height: 40px;
        }
        .main-image-nav.prev { left: 10px; }
        .main-image-nav.next { right: 10px; }
    }
    
    @media (max-width: 900px) {
       .gallery-nav {
         width: 36px;
         height: 36px;
       }
       .gallery-nav.prev { left: 0; }
       .gallery-nav.next { right: 0; }
    }
    
    .gallery-item:hover {
      transform: translateY(-3px);
    }
    
    .gallery-item img {
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important; 
      display: block;
    }

    .btn-primary {
      background-color: var(--primary-red);
      color: white !important;
      padding: 1.3rem 3rem; /* Larger button */
      border: none;
      border-radius: 8px;
      font-size: 1.3rem;
