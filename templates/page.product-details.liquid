      background-color: #b01f15;
      transform: translateY(-2px);
      box-shadow: 0 12px 25px rgba(211, 47, 47, 0.35);
    }

    @media (max-width: 1024px) {
      .product-title { font-size: 2.5rem; }
      .product-hero { gap: 3rem; }
    }

    @media (max-width: 900px) {
      .product-details-page {
          padding-top: 180px; /* Increased to prevent header overlap */
          padding-bottom: 40px;
      }
      .product-hero {
        grid-template-columns: 1fr;
        gap: 2.5rem;
        margin-bottom: 3rem;
      }
      
      .product-image-container {
        height: 350px !important; /* Smaller on mobile */
      }
      
      #main-product-image {
        max-height: 350px;
      }

      .product-info {
        padding-right: 0;
        text-align: left; /* Keep left align for readability */
      }
      
      .product-title {
        font-size: 2.2rem; /* Readable but smaller */
        margin-bottom: 1rem;
      }
      
      .product-description-short {
        font-size: 1.2rem;
      }

      /* Made Button Static for Better Visibility */
      .cta-wrapper {
        position: static;
        width: 100%;
        margin-top: 2rem;
        background: transparent;
        box-shadow: none;
        padding: 0;
        text-align: center; /* Center button on mobile */
      }
      
      .btn-primary {
        width: 100%;
        max-width: 400px;
        font-size: 1.2rem;
        padding: 1.2rem;
      }
      
      .page-width.container {
        padding: 0 1.5rem; /* Slightly less padding on mobile */
      }
      
      .gallery-item {
        flex: 0 0 240px !important;
        width: 240px !important;
        height: 160px !important;
      }
    }
  </style>

{% else %}
  <div class="container page-width" style="padding: 150px 0; text-align: center;">
    <h2>Product Not Found</h2>
    <p>We could not retrieve details for: <strong>{{ handle }}</strong></p>
    <a href="/pages/contact-us" class="btn-primary" style="display:inline-block; margin-top:1rem;">Contact Us</a>
  </div>
{% endif %}
